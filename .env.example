# QiCosmos 环境变量配置示例
# 复制此文件为 .env.local 并填入相应的 API Key

# Supabase（Auth + Postgres）
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXX
# 仅服务端使用，只配置在 Vercel 环境变量，禁止带 NEXT_PUBLIC_ 前缀、禁止提交
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API 密钥（用于 AI 塔罗牌解读与 AI 命理智能推演，如不配置则自动使用内置专家引擎）
GEMINI_API_KEY=
# 或者
# GOOGLE_API_KEY=
