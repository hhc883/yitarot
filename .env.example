# YiTarot 环境变量配置示例
# 复制此文件为 .env.local 并填入相应的 API Key

# Supabase（Auth + Postgres）
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXX
# 仅服务端使用，只配置在 Vercel 环境变量，禁止带 NEXT_PUBLIC_ 前缀、禁止提交
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API 密钥（用于 AI 塔罗牌解读与 AI 命理智能推演，如不配置则自动使用内置专家引擎）
GEMINI_API_KEY=
# 或者
# GOOGLE_API_KEY=

# DeepSeek API 密钥（强烈推荐上线使用：单次解卦成本不足 1 分钱，中文国学理解极佳）
DEEPSEEK_API_KEY=
# 大模型通道首选项：auto | deepseek | gemini（默认 auto，配置了 DEEPSEEK_API_KEY 则优先使用）
METAPHYSICS_LLM_PROVIDER=auto
# DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# 支付配置（双轨体系：海外 Stripe + 国内微信/支付宝/卡密）
# ============================================================

# 1. 海外支付通道（Stripe 全球信用卡 / Apple Pay / Google Pay）
# 申请地址：https://dashboard.stripe.com
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# 2. 国内微信/支付宝聚合支付通道（如虎皮椒 / PayJS / XorPay / 易支付等个人免签聚合网关）
DOMESTIC_PAY_APP_ID=
DOMESTIC_PAY_APP_SECRET=
DOMESTIC_PAY_API_URL=https://api.xunhupay.com/payment/do.html

# 3. 官方安全卡密/兑换码签名私钥（用于生成防伪卡密，如未配置则自动使用 SUPABASE_SERVICE_ROLE_KEY 前 32 位）
REDEEM_SECRET_KEY=yitarot-domestic-redeem-secret-key-2026
