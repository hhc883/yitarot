# YiTarot 环境变量配置示例
# 复制此文件为 .env.local 并填入相应的 API Key

# Supabase（Auth + Postgres）
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXX
# 仅服务端使用，只配置在 Vercel 环境变量，禁止带 NEXT_PUBLIC_ 前缀、禁止提交
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API 密钥（用于 AI 塔罗牌解读与 AI 命理智能推演，如不配置则自动使用内置专家引擎）
GEMINI_API_KEY=
# 或者
# GOOGLE_API_KEY=

# DeepSeek API 密钥（强烈推荐上线使用：单次解卦成本不足 1 分钱，中文国学理解极佳）
DEEPSEEK_API_KEY=
# 大模型通道首选项：auto | deepseek | gemini（默认 auto，配置了 DEEPSEEK_API_KEY 则优先使用）
METAPHYSICS_LLM_PROVIDER=auto
# DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# 支付配置（双轨体系：海外 Payhip/PayPal + 国内微信/支付宝/卡密）
# ============================================================

# 1. 海外 Payhip / PayPal 支付通道
# 获取地址：Payhip Settings > Developer > API Key
PAYHIP_API_KEY=

# 2. 国内微信/支付宝聚合支付通道（虎皮椒 / Xunhupay，单商户通道）
DOMESTIC_PAY_APP_ID=
DOMESTIC_PAY_APP_SECRET=
DOMESTIC_PAY_API_URL=https://api.xunhupay.com/payment/do.html

# Official origin for trusted return/callback URLs. HTTPS only.
# Falls back to NEXT_PUBLIC_SITE_URL when set.
PAYMENT_SITE_URL=https://yitarot.net
# Vercel is auto-detected. Use cloudflare only when all origin traffic comes through Cloudflare IP Geolocation.
# PAYMENT_GEO_SOURCE=cloudflare
# Configure one actual Xunhupay merchant integration (must match its account).
DOMESTIC_PAY_CHANNEL=wechat

# Optional legacy Stripe checkout; both values are required to create a session.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dedicated 32+ character secret. No built-in fallback. Generates YITA2 codes.
REDEEM_SECRET_KEY=
# Set to 1 only if previously-issued codes used this uncompromised explicit secret.
# REDEEM_ALLOW_LEGACY=1
